{
  "name": "german-key-assist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run format:check && npm run test && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && npm run build",
    "build:windows-release": "tauri build --bundles nsis",
    "build:macos-release": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.577.0",
    "motion-v": "^2.4.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42"
  }
}
